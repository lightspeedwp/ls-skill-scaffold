{
  "name": "{{skillSlug}}",
  "version": "{{version}}",
  "description": "{{skillDescription}}",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    {{#hasBatsTests}}
    "test:bats": "bats tests/**/*.bats 2>/dev/null || echo '✓ No BATS tests'",
    {{/hasBatsTests}}
    "test:all": "npm run test{{#hasBatsTests}} && npm run test:bats{{/hasBatsTests}}",
    "lint:js": "eslint . --ext .js,.cjs",
    "lint:md": "markdownlint '**/*.md'",
    "lint:all": "npm run lint:js && npm run lint:md",
    "validate": "npm run lint:all && npm run test:all"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "^10.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "markdownlint-cli": "^0.39.0",
    "lefthook": "^1.8.0"
  },
  "author": "{{authorName}}",
  "license": "{{license}}",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/{{skillSlug}}.git"
  },
  "keywords": [
    "{{skillSlug}}",
    "validation",
    "linting"
  ]
}
