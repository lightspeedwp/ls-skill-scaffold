# Lefthook Configuration for {{skillName}}
#
# Variables:
# - hasShellScripts: Include shellcheck for shell scripts (default: false)
# - hasProductionDeps: Run production dependency checks (default: false)
# - skipTests: Skip Jest tests in pre-commit (default: false)
# - branchPattern: Branch naming pattern regex. The default follows the LightSpeed
#   {type}/{scope}-{title} strategy and also allows main, master, bot branches
#   and release/vX.Y.Z.

pre-commit:
  parallel: true
  jobs:
    - name: prettier
      glob: '*.{js,json,yml,yaml,md}'
      run: npx prettier --write {staged_files}

    - name: markdownlint
      glob: '*.md'
      run: npx markdownlint {staged_files}

    {{^skipTests}}
    - name: jest tests
      run: npm test -- --coverage
    {{/skipTests}}

    - name: eslint
      glob: '*.js'
      run: npx eslint {staged_files}

    {{#hasYamlLinting}}
    - name: yamllint
      glob: '*.{yml,yaml}'
      run: yamllint {staged_files} || echo '✓ YAML lint check'
    {{/hasYamlLinting}}

    {{#hasShellScripts}}
    - name: shellcheck
      glob: '*.sh'
      run: |
        if ! command -v shellcheck >/dev/null 2>&1; then
          echo "❌ shellcheck is not installed. Install it with: brew install shellcheck (macOS) or apt-get install shellcheck (Linux)"
          exit 1
        fi
        shellcheck {staged_files}
    {{/hasShellScripts}}

pre-push:
  jobs:
    - name: validate branch name
      run: |
        BRANCH=$(git rev-parse --abbrev-ref HEAD)
        PATTERN='{{branchPattern}}'
        if ! printf '%s\n' "$BRANCH" | grep -Eq "$PATTERN"; then
          echo "❌ Branch name '$BRANCH' does not match: $PATTERN"
          echo "   Use type/scope-title, for example feat/blocks-add-hero or fix/import-null-check."
          exit 1
        fi
