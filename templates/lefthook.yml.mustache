# Lefthook Configuration for {{skillName}}
#
# Variables:
# - hasShellScripts: Include shellcheck for shell scripts (default: false)
# - hasProductionDeps: Run production dependency checks (default: false)
# - skipTests: Skip Jest tests in pre-commit (default: false)
# - branchPattern: Branch naming pattern regex (default: '^(feature|fix|docs|test|refactor)/')

pre-commit:
  parallel: true
  jobs:
    - name: prettier
      glob: '*.{js,json,yml,yaml,md}'
      run: npx prettier --write {staged_files}

    - name: markdownlint
      glob: '*.md'
      run: npx markdownlint {staged_files}

    {{^skipTests}}
    - name: jest tests
      run: npm test -- --coverage
    {{/skipTests}}

    - name: eslint
      glob: '*.js'
      run: npx eslint {staged_files}

    {{#hasYamlLinting}}
    - name: yamllint
      glob: '*.{yml,yaml}'
      run: yamllint {staged_files} || echo '✓ YAML lint check'
    {{/hasYamlLinting}}

    {{#hasShellScripts}}
    - name: shellcheck
      glob: '*.sh'
      run: shellcheck skill/scripts/*.sh || true
    {{/hasShellScripts}}

pre-push:
  jobs:
    - name: validate branch name
      run: |
        BRANCH=$(git rev-parse --abbrev-ref HEAD)
        PATTERN="{{branchPattern}}"
        if [[ ! $BRANCH =~ $PATTERN ]]; then
          echo "❌ Branch name must match pattern: $PATTERN"
          echo "   Examples: feature/..., fix/..., docs/..., test/..., refactor/..."
          exit 1
        fi
