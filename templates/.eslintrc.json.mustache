{
  "env": {
    "node": true,
    "es2020": true{{#useEsModules}},
    "es6": true{{/useEsModules}}
  },
  "parserOptions": {
    "ecmaVersion": 2020{{#useEsModules}},
    "sourceType": "module"{{/useEsModules}},
    "requireConfigFile": false
  },
  "extends": "eslint:recommended",
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "comma-dangle": ["error", "always-multiline"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "prefer-const": "warn"{{#strictMode}},
    "no-var": "error",
    "prefer-arrow-callback": "warn",
    "no-implicit-coercion": "error",
    "no-param-reassign": "warn",
    "object-shorthand": "warn",
    "prefer-template": "warn"{{/strictMode}}
  }{{#useEsModules}},
  "overrides": [
    {
      "files": ["*.cjs"],
      "parserOptions": {
        "sourceType": "script"
      }
    }
  ]{{/useEsModules}}
}
