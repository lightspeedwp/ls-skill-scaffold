{
  "name": "{{skillSlug}}",
  "version": "{{version}}",
  "description": "{{skillDescription}}",
  "main": "index.js",
  "engines": {
    "node": ">={{nodeVersion}}0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    {{#hasProductionDeps}}
    "start": "node index.js",
    {{/hasProductionDeps}}
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    {{#hasBatsTests}}
    "test:bats": "bats tests/**/*.bats 2>/dev/null || echo '✓ No BATS tests yet'",
    {{/hasBatsTests}}
    "test:all": "npm run test{{#hasBatsTests}} && npm run test:bats{{/hasBatsTests}}",
    "lint:js": "eslint . --ext .js,.cjs,.mjs",
    "lint:md": "markdownlint '**/*.md'",
    {{#hasYamlLinting}}
    "lint:yaml": "yamllint . --config-file .yamllint.yml || echo '✓ YAML linting via yamllint'",
    {{/hasYamlLinting}}
    {{^hasYamlLinting}}
    "lint:yaml": "echo '✓ YAML linting via yamllint (install separately if needed)'",
    {{/hasYamlLinting}}
    "lint:all": "npm run lint:js && npm run lint:md"{{#hasYamlLinting}} && npm run lint:yaml{{/hasYamlLinting}}
    {{#hasMigrationApi}}
    ,
    "migrate:budget": "node skill/api/migrate-with-budget.js"
    {{/hasMigrationApi}}
  },
  {{#hasProductionDeps}}
  "dependencies": {
    {{#hasAnthropicSdk}}
    "@anthropic-ai/sdk": "^0.24.3"
    {{/hasAnthropicSdk}}
  },
  {{/hasProductionDeps}}
  {{^hasProductionDeps}}
  "dependencies": {},
  {{/hasProductionDeps}}
  "devDependencies": {
    "eslint": "^10.14.0",
    {{#hasYamlLinting}}
    "eslint-plugin-yml": "^3.9.0",
    {{/hasYamlLinting}}
    "jest": "^29.7.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10"
    {{#hasYamlLinting}}
    ,
    "yamllint": "^2.14.0"
    {{/hasYamlLinting}}
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "__tests__/**/*.test.js"
      {{#hasShellScripts}}
      ,
      "skill/scripts/**/*.js"
      {{/hasShellScripts}}
    ],
    "coverageThreshold": {
      "global": {
        "branches": {{testCoverageThreshold}},
        "functions": {{testCoverageThreshold}},
        "lines": {{testCoverageThreshold}},
        "statements": {{testCoverageThreshold}}
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [
    "wordpress",
    "claude",
    "skill"
  ],
  "author": "{{authorName}}",
  "license": "{{license}}"
}
