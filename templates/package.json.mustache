{
  "name": "{{repo_name}}",
  "version": "{{version}}",
  "description": "{{repo_description}}",
  "main": "index.js",
  {{#min_node_version}}"engines": {
    "node": ">=24.0.0"
  },{{/min_node_version}}
  "scripts": {
    "prepare": "lefthook install",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    {{#has_bats}}"test:bats": "bats tests/**/*.bats 2>/dev/null || echo '✓ No BATS tests yet'",
    "test:all": "npm run test{{#has_bats}} && npm run test:bats{{/has_bats}}",{{/has_bats}}
    "lint:js": "eslint . --ext .js,.cjs,.mjs",
    "lint:md": "markdownlint '**/*.md'",
    {{#has_yaml}}"lint:yaml": "echo '✓ YAML linting via yamllint (install separately if needed)'",{{/has_yaml}}
    "lint:all": "npm run lint:js && npm run lint:md"{{#has_yaml}} && npm run lint:yaml{{/has_yaml}},
    {{#has_migrate}}"migrate:budget": "node skill/api/migrate-with-budget.js"{{/has_migrate}}
  },
  "dependencies": {
    {{#has_anthropic}}"@anthropic-ai/sdk": "^0.24.3"{{/has_anthropic}}
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    {{#has_yaml}}"eslint-plugin-yml": "^3.9.0",{{/has_yaml}}
    "jest": "^29.7.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "__tests__/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": {{coverage_threshold}},
        "functions": {{coverage_threshold}},
        "lines": {{coverage_threshold}},
        "statements": {{coverage_threshold}}
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [
    "wordpress",
    "claude",
    "skill"
  ],
  "author": "{{author}}",
  "license": "MIT"
}
