{
  "version": "1.0.0",
  "name": "skill-scaffold",
  "description": "Universal scaffold for WordPress/Claude skills",
  "templates": [
    {
      "source": "templates/package.json.mustache",
      "target": "package.json",
      "overwrite": false,
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/lefthook.yml.mustache",
      "target": "lefthook.yml",
      "overwrite": true,
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.coderabbit.yaml.mustache",
      "target": ".coderabbit.yaml",
      "overwrite": true,
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.eslintrc.json.mustache",
      "target": ".eslintrc.json",
      "overwrite": true,
      "required": false,
      "phase": 2
    },
    {
      "source": "templates/SKILL.md.mustache",
      "target": "SKILL.md",
      "overwrite": false,
      "required": false,
      "phase": 2
    },
    {
      "source": "templates/.editorconfig.mustache",
      "target": ".editorconfig",
      "overwrite": true,
      "required": true,
      "phase": 2
    },
    {
      "source": "templates/.github/workflows/ci.yml.mustache",
      "target": ".github/workflows/ci.yml",
      "overwrite": true,
      "required": false,
      "phase": 2
    },
    {
      "source": "templates/.markdownlint.json.mustache",
      "target": ".markdownlint.json",
      "overwrite": true,
      "required": false,
      "phase": 2
    }
  ],
  "files": [
    {
      "source": "templates/.eslintrc.cjs",
      "target": ".eslintrc.cjs",
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.prettierrc",
      "target": ".prettierrc",
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.markdownlint.jsonc",
      "target": ".markdownlint.jsonc",
      "required": true,
      "phase": 1
    }
  ],
  "requiredVariables": [
    "repo_name",
    "repo_description",
    "author",
    "version"
  ],
  "optionalVariables": {
    "min_node_version": "24.0.0",
    "coverage_threshold": 80,
    "branch_pattern": "^(wp-db-|skill-|main|develop|master)$",
    "branch_prefix": "skill-",
    "has_jest": true,
    "has_bats": false,
    "has_shell": false,
    "has_yaml": false,
    "has_anthropic": false,
    "has_migrate": false
  },
  "postInstall": {
    "run": [
      "npm install",
      "npx lefthook install",
      "npm run lint:all"
    ]
  }
}
