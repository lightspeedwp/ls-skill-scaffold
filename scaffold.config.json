{
  "version": "1.0.0",
  "name": "skill-scaffold",
  "description": "Universal scaffold for WordPress/Claude skills",
  "templates": [
    {
      "source": "templates/package.json.mustache",
      "target": "package.json",
      "overwrite": false,
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/lefthook.yml.mustache",
      "target": "lefthook.yml",
      "overwrite": true,
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.coderabbit.yaml.mustache",
      "target": ".coderabbit.yaml",
      "overwrite": true,
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.eslintrc.json.mustache",
      "target": ".eslintrc.json",
      "overwrite": true,
      "required": false,
      "phase": 2
    },
    {
      "source": "templates/SKILL.md.mustache",
      "target": "SKILL.md",
      "overwrite": false,
      "required": false,
      "phase": 2
    },
    {
      "source": "templates/.editorconfig.mustache",
      "target": ".editorconfig",
      "overwrite": true,
      "required": true,
      "phase": 2
    },
    {
      "source": "templates/.github/workflows/ci.yml.mustache",
      "target": ".github/workflows/ci.yml",
      "overwrite": true,
      "required": false,
      "phase": 2
    },
    {
      "source": "templates/.markdownlint.json.mustache",
      "target": ".markdownlint.json",
      "overwrite": true,
      "required": false,
      "phase": 2
    },
    {
      "source": "templates/jest.config.js.strict.mustache",
      "target": "jest.config.js.strict",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "variant": "jest:strict"
    },
    {
      "source": "templates/jest.config.js.esm.mustache",
      "target": "jest.config.js.esm",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "variant": "jest:esm"
    },
    {
      "source": "templates/package.json.cli.mustache",
      "target": "package.json.cli",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "variant": "package.json:cli"
    },
    {
      "source": "templates/package.json.validation.mustache",
      "target": "package.json.validation",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "variant": "package.json:validation"
    },
    {
      "source": "templates/package.json.docs.mustache",
      "target": "package.json.docs",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "variant": "package.json:docs"
    },
    {
      "source": "templates/.eslintrc.strict.mustache",
      "target": ".eslintrc.strict",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "variant": "eslintrc:strict"
    },
    {
      "source": "templates/.eslintrc.browser.mustache",
      "target": ".eslintrc.browser",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "variant": "eslintrc:browser"
    },
    {
      "source": "templates/.github/workflows/test.yml.mustache",
      "target": ".github/workflows/test.yml",
      "overwrite": true,
      "required": false,
      "phase": 3,
      "variant": "workflow:test-only"
    },
    {
      "source": "templates/.github/workflows/test-matrix.yml.mustache",
      "target": ".github/workflows/test-matrix.yml",
      "overwrite": true,
      "required": false,
      "phase": 3,
      "variant": "workflow:test-matrix"
    },
    {
      "source": "templates/.github/workflows/release.yml.mustache",
      "target": ".github/workflows/release.yml",
      "overwrite": true,
      "required": false,
      "phase": 3,
      "variant": "workflow:release"
    },
    {
      "source": "templates/.github/workflows/security.yml.mustache",
      "target": ".github/workflows/security.yml",
      "overwrite": true,
      "required": false,
      "phase": 3,
      "variant": "workflow:security"
    },
    {
      "source": "templates/AGENTS.md.mustache",
      "target": "AGENTS.md",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "specialized": true
    },
    {
      "source": "templates/PROMPT_TEMPLATE.md.mustache",
      "target": "PROMPT_TEMPLATE.md",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "specialized": true
    },
    {
      "source": "templates/.npmignore.mustache",
      "target": ".npmignore",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "specialized": true,
      "note": "Merge with existing .npmignore to preserve custom rules; security-critical secrets always ignored"
    },
    {
      "source": "templates/.gitignore.mustache",
      "target": ".gitignore",
      "overwrite": false,
      "required": false,
      "phase": 3,
      "specialized": true,
      "note": "Merge with existing .gitignore to preserve custom rules; .env files unconditionally ignored"
    }
  ],
  "files": [
    {
      "source": "templates/.eslintrc.cjs",
      "target": ".eslintrc.cjs",
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.prettierrc",
      "target": ".prettierrc",
      "required": true,
      "phase": 1
    },
    {
      "source": "templates/.markdownlint.jsonc",
      "target": ".markdownlint.jsonc",
      "required": true,
      "phase": 1
    }
  ],
  "requiredVariables": [
    "repo_name",
    "repo_description",
    "author",
    "version"
  ],
  "optionalVariables": {
    "min_node_version": "24.0.0",
    "coverage_threshold": 80,
    "branch_pattern": "^(wp-db-|skill-|main|develop|master)$",
    "branch_prefix": "skill-",
    "has_jest": true,
    "has_bats": false,
    "has_shell": false,
    "has_yaml": false,
    "has_anthropic": false,
    "has_migrate": false
  },
  "postInstall": {
    "run": [
      "npm install",
      "npx lefthook install",
      "npm run lint:all"
    ]
  }
}
